{
  "version": "1.0.0",
  "routes": [
    {
      "path": "/",
      "layout": "home",
      "auth_required": false
    },
    {
      "path": "/401",
      "layout": "errors/401",
      "auth_required": false
    },
    {
      "path": "/403",
      "layout": "errors/403",
      "auth_required": false
    },
    {
      "path": "/404",
      "layout": "errors/404",
      "auth_required": false
    },
    {
      "path": "/500",
      "layout": "errors/500",
      "auth_required": false
    },
    {
      "path": "/503",
      "layout": "errors/503",
      "auth_required": false
    },
    {
      "path": "/page/:slug",
      "layout": "page/show",
      "auth_required": false
    },
    {
      "path": "/board/:slug/write",
      "layout": "board/form",
      "auth_required": false
    },
    {
      "path": "/board/:slug/:id/edit",
      "layout": "board/form",
      "auth_required": false
    },
    {
      "path": "/board/:slug/:id",
      "layout": "board/show",
      "auth_required": false
    },
    {
      "path": "/board/:slug",
      "layout": "board/index",
      "auth_required": false
    }
  ]
}
