{
  "contract_version": "1.0.0",
  "template_identifier": "jwsoft-business01",
  "supported_versions": ">=0.1.0 <0.2.0",
  "contract_schema": "contracts/layout-data.schema.json",
  "site_structure_contract": "contracts/site-structure.json",
  "page_content_contract": "contracts/page-content.json",
  "slots": [
    {
      "key": "primary_navigation",
      "layout_name": "_user_base",
      "selector": {
        "node_id": "jw-primary-navigation",
        "field": "children"
      },
      "allowed_fields": [
        "children"
      ],
      "reference_types": [
        "menu"
      ],
      "schema": "contracts/slot-nodes.schema.json",
      "dependencies": [],
      "render_targets": [
        "desktop",
        "mobile"
      ]
    },
    {
      "key": "footer_navigation",
      "layout_name": "_user_base",
      "selector": {
        "node_id": "jw-footer-navigation",
        "field": "children"
      },
      "allowed_fields": [
        "children"
      ],
      "reference_types": [
        "menu"
      ],
      "schema": "contracts/slot-nodes.schema.json",
      "dependencies": [],
      "render_targets": [
        "footer"
      ]
    },
    {
      "key": "company_profile",
      "layout_name": "home",
      "selector": {
        "node_id": "jw-company-profile",
        "field": "children"
      },
      "allowed_fields": [
        "children"
      ],
      "reference_types": [
        "page"
      ],
      "schema": "contracts/slot-nodes.schema.json",
      "dependencies": [],
      "render_targets": [
        "home"
      ]
    },
    {
      "key": "home_services",
      "layout_name": "home",
      "selector": {
        "node_id": "jw-home-services",
        "field": "children"
      },
      "allowed_fields": [
        "children"
      ],
      "reference_types": [
        "page",
        "post",
        "board"
      ],
      "schema": "contracts/slot-nodes.schema.json",
      "dependencies": [],
      "render_targets": [
        "home"
      ]
    },
    {
      "key": "home_cases",
      "layout_name": "home",
      "selector": {
        "node_id": "jw-home-cases",
        "field": "children"
      },
      "allowed_fields": [
        "children"
      ],
      "reference_types": [
        "post",
        "board"
      ],
      "schema": "contracts/slot-nodes.schema.json",
      "dependencies": [],
      "render_targets": [
        "home"
      ]
    }
  ],
  "write_mode": "immediate",
  "baseline_mode": "replace_children_preserve_previous",
  "concurrency_capability": "g7.layout.content.row-lock.v1",
  "restore_mode": "compare_applied_slot_then_restore_previous",
  "public_routes": {
    "page": {
      "path": "/page/:slug",
      "layout_name": "page/show"
    },
    "post": {
      "path": "/board/:slug/:id",
      "layout_name": "board/show"
    },
    "board": {
      "path": "/board/:slug",
      "layout_name": "board/index"
    },
    "board_write": {
      "path": "/board/:slug/write",
      "layout_name": "board/form"
    },
    "board_edit": {
      "path": "/board/:slug/:id/edit",
      "layout_name": "board/form"
    }
  },
  "verification": {
    "targets": [
      {
        "key": "home",
        "source": "static",
        "path": "/",
        "assertions": ["http_200", "owned_slots_rendered", "navigation_resolved"]
      },
      {
        "key": "pages",
        "source": "site_structure.pages",
        "public_route": "page",
        "assertions": ["http_200", "non_empty_content", "no_unresolved_reference"]
      },
      {
        "key": "boards",
        "source": "site_structure.boards",
        "public_route": "board",
        "assertions": ["http_200", "minimum_demo_posts", "second_page_has_content"]
      },
      {
        "key": "inquiry_write",
        "source": "site_structure.boards[role=inquiry]",
        "public_route": "board_write",
        "assertions": ["http_200", "guest_write_available", "secret_default_applied"]
      }
    ],
    "install_assertions": [
      "logical_keys_resolve_to_g7_objects",
      "navigation_depth_at_most_two",
      "all_slot_references_resolve",
      "page_content_contract_applied",
      "applied_slot_snapshot_recorded"
    ],
    "remove_assertions": [
      "customer_modified_slots_preserved",
      "customer_modified_objects_preserved",
      "unmodified_owned_slots_restored"
    ]
  }
}
