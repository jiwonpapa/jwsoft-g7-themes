{
  "version": "1.0.0",
  "layout_name": "_user_base",
  "meta": {
    "is_base": true
  },
  "globalHeaders": [
    {
      "pattern": "/api/modules/sirsoft-board/*",
      "headers": {
        "X-Board-Secret-View-Token": "{{_global.secretViewToken}}"
      }
    }
  ],
  "data_sources": [],
  "components": [
    {
      "type": "basic",
      "name": "Div",
      "id": "jw-site",
      "children": [
        {
          "type": "basic",
          "name": "SiteHeader",
          "id": "jw-header",
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "A",
                  "id": "jw-home-link",
                  "text": "$t:user.brand",
                  "props": {
                    "href": "/./",
                    "className": "jw-brand"
                  }
                },
                {
                  "type": "basic",
                  "name": "PrimaryNavigation",
                  "id": "jw-primary-navigation",
                  "props": {
                    "aria-label": "$t:user.navigation",
                    "className": "jw-primary-navigation jw-primary-navigation--panel"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "jw-menu-group"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "A",
                          "text": "$t:user.navigation_items.company",
                          "props": {
                            "href": "/page/company",
                            "className": "jw-navigation-link"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Div",
                          "props": {
                            "className": "jw-submenu"
                          },
                          "children": [
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/company",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.company-overview"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/values",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.company-values"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/history",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.company-history"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/team",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.company-team"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/location",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.company-location"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "jw-menu-group"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "A",
                          "text": "$t:user.navigation_items.services",
                          "props": {
                            "href": "/page/services",
                            "className": "jw-navigation-link"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Div",
                          "props": {
                            "className": "jw-submenu"
                          },
                          "children": [
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/services",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.services-overview"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/process",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.services-process"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "A",
                      "text": "$t:user.navigation_items.cases",
                      "props": {
                        "href": "/board/cases",
                        "className": "jw-navigation-link"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "jw-menu-group"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "A",
                          "text": "$t:user.navigation_items.resources",
                          "props": {
                            "href": "/board/resources",
                            "className": "jw-navigation-link"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Div",
                          "props": {
                            "className": "jw-submenu"
                          },
                          "children": [
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/board/resources",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.insights-resources"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/board/notices",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.insights-notices"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/faq",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.insights-faq"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "jw-menu-group"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "A",
                          "text": "$t:user.navigation_items.contact",
                          "props": {
                            "href": "/board/inquiries/write",
                            "className": "jw-navigation-link jw-navigation-link--action"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Div",
                          "props": {
                            "className": "jw-submenu"
                          },
                          "children": [
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/contact",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.contact-guide"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/board/inquiries/write",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.contact-write"
                            },
                            {
                              "type": "basic",
                              "name": "A",
                              "props": {
                                "href": "/page/privacy",
                                "className": "jw-submenu-link"
                              },
                              "text": "$t:user.subnavigation.contact-privacy"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "composite",
                  "name": "LanguageSwitcher",
                  "props": {
                    "locale": "{{$locale}}"
                  }
                },
                {
                  "type": "composite",
                  "name": "MobileMenuButton",
                  "props": {
                    "targetId": "jw-primary-navigation",
                    "label": "$t:user.menu_open",
                    "closeLabel": "$t:user.menu_close",
                    "className": "jw-menu-button"
                  }
                }
              ],
              "props": {
                "className": "jw-container jw-header-inner"
              }
            }
          ],
          "props": {
            "className": "jw-site-header jw-site-header--standard"
          }
        },
        {
          "type": "basic",
          "name": "Main",
          "id": "jw-content",
          "children": [],
          "slot": "content",
          "props": {
            "className": "jw-main"
          }
        },
        {
          "type": "basic",
          "name": "Footer",
          "id": "jw-footer",
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "A",
                      "text": "$t:user.brand",
                      "props": {
                        "href": "/./",
                        "className": "jw-brand"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "text": "$t:user.footer_copy",
                      "props": {
                        "className": "jw-footer-copy"
                      }
                    }
                  ],
                  "props": {
                    "className": "jw-footer-brand"
                  }
                },
                {
                  "type": "basic",
                  "name": "Nav",
                  "id": "jw-footer-navigation",
                  "props": {
                    "aria-label": "$t:user.footer",
                    "className": "jw-footer-navigation"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "A",
                      "text": "$t:user.navigation_items.company",
                      "props": {
                        "href": "/page/company",
                        "className": "jw-navigation-link"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "A",
                      "text": "$t:user.navigation_items.resources",
                      "props": {
                        "href": "/board/resources",
                        "className": "jw-navigation-link"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "A",
                      "text": "$t:user.navigation_items.contact",
                      "props": {
                        "href": "/board/inquiries/write",
                        "className": "jw-navigation-link"
                      }
                    }
                  ]
                }
              ],
              "props": {
                "className": "jw-container jw-footer-inner"
              }
            }
          ],
          "props": {
            "className": "jw-site-footer"
          }
        }
      ],
      "props": {
        "className": "jw-site"
      }
    }
  ]
}
