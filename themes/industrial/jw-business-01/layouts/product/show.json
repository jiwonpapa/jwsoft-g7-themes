{
  "version": "1.0.0",
  "layout_name": "product/show",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "product",
      "label_key": "$t:user.content",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-ecommerce/products/{{route.product_code}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "blocking"
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "H1",
        "text": "{{product.data.name_localized}}",
        "if": "{{product?.data}}"
      },
      {
        "type": "composite",
        "name": "HtmlContent",
        "if": "{{product?.data}}",
        "props": {
          "content": "{{product.data.description_localized ?? ''}}",
          "isHtml": "{{(product.data.description_mode ?? 'html') === 'html'}}"
        }
      }
    ]
  }
}
