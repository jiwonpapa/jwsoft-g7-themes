{
  "version": "1.0.0",
  "layout_name": "board/show",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "post",
      "label_key": "$t:user.content",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/{{route.id}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "blocking"
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "H1",
        "text": "{{post.data.title}}",
        "if": "{{post?.data}}"
      },
      {
        "type": "composite",
        "name": "HtmlContent",
        "if": "{{post?.data}}",
        "props": {
          "content": "{{post.data.content ?? ''}}",
          "isHtml": "{{(post.data.content_mode ?? 'html') === 'html'}}"
        }
      }
    ]
  }
}
