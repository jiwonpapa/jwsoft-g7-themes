{
  "version": "1.0.0",
  "layout_name": "board/index",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "posts",
      "label_key": "$t:user.content",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "blocking",
      "params": {
        "page": "{{query.page ?? 1}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "H1",
        "text": "{{posts?.data?.board?.name ?? \"\"}}"
      },
      {
        "type": "basic",
        "name": "Div",
        "iteration": {
          "source": "{{posts?.data?.data ?? []}}",
          "item_var": "post"
        },
        "children": [
          {
            "type": "basic",
            "name": "A",
            "text": "{{post.title}}",
            "props": {
              "href": "{{\"/board/\" + route.slug + \"/\" + post.id}}"
            }
          }
        ]
      }
    ]
  }
}
