{
  "version": "1.0.0",
  "layout_name": "page/show",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "page",
      "label_key": "$t:user.content",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-page/pages/{{route.slug}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "blocking"
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "H1",
        "text": "{{page.data.title}}",
        "if": "{{page?.data}}"
      },
      {
        "type": "composite",
        "name": "HtmlContent",
        "if": "{{page?.data}}",
        "props": {
          "content": "{{page.data.content ?? ''}}",
          "isHtml": "{{(page.data.content_mode ?? 'html') === 'html'}}"
        }
      }
    ]
  }
}
