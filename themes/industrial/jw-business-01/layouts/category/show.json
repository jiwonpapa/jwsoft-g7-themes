{
  "version": "1.0.0",
  "layout_name": "category/show",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "category",
      "label_key": "$t:user.content",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-ecommerce/categories/{{route.slug}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "blocking"
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "H1",
        "text": "{{category.data.name_localized}}",
        "if": "{{category?.data}}"
      }
    ]
  }
}
